# Backend settings. Copy to .env (this folder) or set them in your hosting dashboard.

# Aiven PostgreSQL service URI (postgres://...?sslmode=require). DATABASE_URL is also accepted.
AIVEN_DATABASE_URL=
# Optional: path to Aiven's CA certificate (ca.pem) for full TLS verification.
DATABASE_CA_CERT_PATH=

# Superadmin. Synced from these values every time the backend starts.
ADMIN_USERNAME=anish
ADMIN_PASSWORD=
# Random string that signs login tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Frontend URL(s) allowed to call the API (comma-separated), and the URL used in notification links.
FRONTEND_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# How long a login lasts, in hours.
TOKEN_TTL_HOURS=168

# Notifications when a writer finishes and when all writers have finished. Configure either or both.
# Email (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Webhook (Discord or Slack incoming-webhook URL)
NOTIFY_WEBHOOK_URL=
